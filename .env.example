# Get this from Google AI Studio.
# Either name works; GEMINI_API_KEY is preferred by the current Gemini API docs.
GEMINI_API_KEY=

# User-requested default model. Override if Google exposes this under another ID.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional advanced overrides.
GEMINI_API_VERSION=v1beta
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Optional: override the assistant style used by the CLI.
# GEMMA_SYSTEM_PROMPT=Reply with concise, polished terminal-friendly answers.

# Optional: Ollama local base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
